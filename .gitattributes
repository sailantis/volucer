# Shell scripts run on Unix, where CR is not whitespace — a `case` arm becomes a syntax error
# (`$'\r'`), which is how the packaging scripts failed the first time they were run. `.editorconfig`
# asks for LF on write; this is the half that survives a checkout, and Windows has
# `core.autocrlf=true` by default.
*.sh text eol=lf

# Workflows are YAML parsed by GitHub, and a stray CR in a `run:` block reaches the shell.
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell is the one script here that Windows runs, so it is the one script that may keep
# CRLF. Declared rather than left to `core.autocrlf`, because an installer with LF-only line
# endings is rejected by some Windows hosts on the first line.
*.ps1 text eol=crlf

# The Dockerfile's `RUN` lines are shell too.
Dockerfile text eol=lf
